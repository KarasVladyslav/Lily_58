#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        DoubleSpace {
            bindings = <&kp LG(ENTER)>;
            key-positions = <53 54>;
        };

        SpaceLayer {
            bindings = <&tog 2>;
            key-positions = <5 6>;
        };

        ProgrammingLayer {
            bindings = <&to 0>;
            key-positions = <4 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                       &kp N6       &kp N7     &kp N8         &kp N9   &kp N0    &kp RIGHT_BRACKET
&kp TAB         &kp Q   &kp W   &kp E     &kp R     &kp T                                        &kp Y        &kp U      &kp I          &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S   &kp D     &kp F     &kp G                                        &kp H        &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C     &kp V     &kp B   &kp DEL                   &kp BSLH   &kp N        &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp ENTER
                                &kp LALT  &kp LWIN  &mo 1   &mt LEFT_WIN LS(SPACE)    &kp SPACE  &lt 1 MINUS  &kp EQUAL  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
@@ -60,5 +70,18 @@

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Space {
            display-name = "Base";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6       &kp N7     &kp N8         &kp N9   &kp N0    &kp RIGHT_BRACKET
&kp TAB         &kp Q   &kp W   &kp E     &kp R     &kp T                           &kp Y        &kp U      &kp I          &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S   &kp D     &kp F     &kp G                           &kp H        &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C     &kp V     &kp B   &kp DEL      &kp BSLH   &kp N        &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp ENTER
                                &kp LALT  &kp LWIN  &mo 1   &kp SPACE    &kp SPACE  &lt 1 MINUS  &kp EQUAL  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
